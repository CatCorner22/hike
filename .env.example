# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Signs the per-browser owner cookie that scopes plans and activities to one person.
# REQUIRED in production: without it the API refuses to read or write user data rather
# than falling back to a shared identity. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Rotating this invalidates every session and orphans existing rows. Set it once.
# (OWNER_TOKEN_SECRET is accepted as a legacy alias for the same value.)
SESSION_SECRET=

# Public canonical origin used for absolute social/preview metadata.
# Example: https://hike.example.com (no trailing slash required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production-only: allow the JSON file fallback instead of Postgres.
# Never set this on a multi-instance host (Vercel). The file is not shared.
# ALLOW_LOCAL_STORE_IN_PRODUCTION=true

# External APIs
NPS_API_KEY=
RIDB_API_KEY=

# Optional Nominatim-compatible geocoder. When unset, submit-only place searches
# use the rate-limited public OpenStreetMap Nominatim service. For sustained or
# multi-instance production traffic, point this at a service you operate or a
# provider whose usage terms cover your volume. Do not use it for autocomplete.
GEOCODER_BASE_URL=

# AI research and Pioneer (use one of the two keys)
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
TAVILY_API_KEY=
# Pioneer is the SuperByte/Spirit-style observational advisor. It opens when
# either key above is set. PIONEER_ENABLED=0 closes it; PIONEER_KILL=1 is the
# silent operator killswitch and is never mentioned to the model.
# PIONEER_MODEL=openai/gpt-4o-mini
# PIONEER_READS=1

# Optional map tiles (MapTiler outdoor free tier)
NEXT_PUBLIC_MAPTILER_KEY=
