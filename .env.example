# REQUIRED IN PRODUCTION.
# Signs the anonymous device-owner cookie that scopes plans, activities and GPS
# tracks to a device. Without it the server refuses to start rather than serve
# unscoped data, because activity_points is a precise movement history.
# Generate one with:  openssl rand -base64 32
OWNER_TOKEN_SECRET=

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# External APIs
NPS_API_KEY=
RIDB_API_KEY=

# AI research (use one)
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=
TAVILY_API_KEY=

# Optional map tiles (MapTiler outdoor free tier)
NEXT_PUBLIC_MAPTILER_KEY=
